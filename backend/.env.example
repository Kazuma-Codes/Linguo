# Required: Groq API key (free at https://console.groq.com)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# JWT secret (min 32 chars, change for production)
SECRET_KEY=supersecretkey_change_me_later!!

# Database (PostgreSQL) — Spring wants JDBC form:
#   docker (local, no SSL): jdbc:postgresql://localhost:5432/translate_app
#   managed (Neon/Render, SSL): jdbc:postgresql://<host>:5432/<db>?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/translate_app
DATABASE_USERNAME=user
DATABASE_PASSWORD=password

# Redis (Upstash provides REDIS_URL, or use local Redis)
REDIS_URL=redis://redis:6379

# PostgreSQL container config
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=translate_app

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Google Sign-In (Web OAuth client ID from https://console.cloud.google.com)
# Android client ID optional — needed only for the Expo dev-build Google button
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
